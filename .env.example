# saipa-engine environment variables
# Copy to .env and fill in your values

# --- License ---
SAIPA_LICENSE_KEY=your-license-key-here
SAIPA_LICENSE_VALIDATION_URL=https://api.schaller-ponce.com.ar/license/validate
SAIPA_OFFLINE_GRACE_DAYS=30

# --- API Security ---
# Token that Moodle must send as "Authorization: Bearer <token>".
# REQUIRED: the engine refuses to start with an empty token.
# Generate one with: openssl rand -hex 32
SAIPA_API_TOKEN=change-this-in-production
# Local development only: allow an empty SAIPA_API_TOKEN and disable Bearer auth.
# Never set this in a deployment.
SAIPA_DEV_MODE=false

# --- Moodle Connection ---
MOODLE_URL=http://localhost:8080
MOODLE_TOKEN=your-moodle-webservice-token
# Optional: Host header to send to Moodle (behind a reverse proxy). Empty = use MOODLE_URL's host.
MOODLE_PUBLIC_HOST=

# --- LLM provider ---
# "ollama" or "anthropic" -- this is the university admin's decision (who to
# contract and pay for the model), not ours.
# REQUIRED: the engine refuses to start with this unset (unless SAIPA_DEV_MODE=true).
LLM_PROVIDER=ollama

# --- Ollama (used when LLM_PROVIDER=ollama; self-hosted, no API key) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
# REQUIRED if LLM_PROVIDER=anthropic (same fail-closed rule as SAIPA_API_TOKEN).
ANTHROPIC_API_KEY=
# Recommended defaults -- Haiku for SAIPA chat/RAG/alerts, Sonnet+ for EVAL-IA
# grading (a weak model gives defensible-looking wrong scores on free-text
# answers). Override if you'd rather use a different tier.
ANTHROPIC_MODEL_CHAT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_GRADING=claude-sonnet-5

# --- Embeddings ---
# Always sentence-transformers (CPU, no GPU or extra API key) -- not
# configurable per install like the LLM, there's no admin decision here.
# Changing this requires deleting and recreating every course's ChromaDB
# collection (ChromaDB rejects a dimension change outright) and re-indexing.
SENTENCE_TRANSFORMERS_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_data

# --- Telegram (leave TELEGRAM_BOT_TOKEN empty to disable the channel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
EVALIA_DEMO_TELEGRAM_ID=

# --- WhatsApp ---
# whatsapp/client.py (Evolution API) is the only implementation (E9,
# 2026-09-16 -- Twilio config was dead scaffolding, removed). NOT mounted
# as a router in main.py yet -- these settings have no effect until that
# channel is actually wired up.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=saipa
WHATSAPP_WEBHOOK_URL=

# --- Logging ---
LOG_LEVEL=INFO
